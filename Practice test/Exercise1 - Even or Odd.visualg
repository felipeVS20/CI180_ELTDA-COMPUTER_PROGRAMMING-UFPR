// [1] Write a program to indicate wheter a number is even or odd.
// If it's even, write "The [NUMBER] is even". If it's odd, then display
// "The [NUMBER] is odd".


algoritmo "Even or Odd"

var
  number: inteiro

inicio
// Type a number
  leia(number)
  se number mod 2 = 0 entao
  escreval("The number ", number, " is even")
  senao
  escreval("The number ", number, " is odd")
  fimse

fimalgoritmo
